<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml: Android应用的配置清单文件
     包含应用的包名、组件(Activity/Service/Receiver)、权限声明等核心信息
     系统根据此文件了解应用的结构和运行需求 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 权限声明 ==================== -->

    <!-- 位置权限: 用于获取 GPS 和网络定位信息 -->
    <!-- ACCESS_FINE_LOCATION: 精确位置(GPS)，精度约 2-10 米 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- ACCESS_COARSE_LOCATION: 大概位置(网络/WiFi)，精度约 50-1000 米 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ACTIVITY_RECOGNITION: 活动识别权限，用于检测用户行为(步行/跑步/静止等)
         Android 10+ 需要动态申请此权限才能访问计步器等传感器 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 硬件特性声明: 指定应用需要的设备硬件
         android:required="true" 表示必须有此硬件才能安装
         android:required="false" 表示可选，应用会在无此硬件时降级处理 -->
    <!-- 加速度计(必需) -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <!-- 陀螺仪(可选) -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <!-- 罗盘/磁力计(可选) -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- FOREGROUND_SERVICE: 前台服务权限，允许应用在状态栏显示常驻通知
         用于在后台持续运行任务(如定位、计步)而不被系统杀死 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_HEALTH: Android 14+ 新增，健康类型前台服务必须声明
         与 android:foregroundServiceType="health" 配合使用 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- POST_NOTIFICATIONS: 通知发送权限
         Android 13+ 必须动态申请，否则无法显示通知(包括前台服务的常驻通知) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WAKE_LOCK: 唤醒锁权限，防止设备CPU休眠
         用于确保后台传感器数据采集不被中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ==================== 应用配置 ==================== -->
    <!-- <application>: 声明应用级别的配置，一个manifest只能有一个 -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PDR"
        tools:targetApi="31">
        <!-- 属性说明:
             android:name=".App" - 自定义Application类，应用启动时最先实例化，用于全局初始化
             android:allowBackup="true" - 允许系统备份应用数据
             android:dataExtractionRules - Android 12+ 备份规则文件
             android:fullBackupContent - 旧版备份规则文件
             android:icon - 应用图标(显示在桌面/应用列表)
             android:label - 应用名称(显示在桌面图标下方)
             android:roundIcon - 圆形图标(部分启动器使用)
             android:supportsRtl - 支持从右到左的语言布局(如阿拉伯语)
             android:theme - 应用默认主题样式
             tools:targetApi="31" - 指示lint工具按API 31规则检查，避免警告 -->

        <!-- ==================== Activity组件 ==================== -->
        <!-- Activity: Android四大组件之一，代表一个用户界面屏幕
             android:exported="true" - 允许外部应用启动此Activity(启动入口必须为true) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PDR">

            <!-- intent-filter: 意图过滤器，定义组件能响应的隐式Intent -->
            <intent-filter>
                <!-- MAIN + LAUNCHER 组合: 标识此为应用的主入口Activity
                     点击桌面图标时系统会启动此Activity -->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== Service组件 ==================== -->
        <!-- Service: Android四大组件之一，无界面的后台运行组件
             android:enabled="true" - 服务是否可被系统实例化
             android:exported="false" - 禁止外部应用启动此服务(私有服务)
             android:foregroundServiceType="health" - Android 14+ 前台服务类型声明 -->
        <service
            android:name=".service.PDRService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>

</manifest>
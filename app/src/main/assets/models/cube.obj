# Simple Cube
# 顶点
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# 法线
vn  0  0 -1
vn  0  0  1
vn  0 -1  0
vn  0  1  0
vn -1  0  0
vn  1  0  0

# 面 (顶点索引//法线索引)
# 前面
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# 后面
f 5//2 7//2 6//2
f 5//2 8//2 7//2
# 底面
f 1//3 5//3 6//3
f 1//3 6//3 2//3
# 顶面
f 4//4 3//4 7//4
f 4//4 7//4 8//4
# 左面
f 1//5 4//5 8//5
f 1//5 8//5 5//5
# 右面
f 2//6 6//6 7//6
f 2//6 7//6 3//6
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- 首页 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.pdr.ui.home.HomeFragment"
        android:label="首页">
        <action
            android:id="@+id/action_home_to_main"
            app:destination="@id/mainFragment" />
    </fragment>

    <!-- PDR 主页面 -->
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.pdr.ui.main.MainFragment"
        android:label="Main">
        <argument
            android:name="trajectoryId"
            android:defaultValue="0L"
            app:argType="long" />
        <action
            android:id="@+id/action_main_to_history"
            app:destination="@id/historyFragment" />
    </fragment>

    <!-- 历史记录页面 -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.pdr.ui.history.HistoryFragment"
        android:label="历史轨迹">
        <action
            android:id="@+id/action_history_to_main"
            app:destination="@id/mainFragment" />
    </fragment>

</navigation>